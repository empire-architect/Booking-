# LiteAPI server credentials (required)
LITEAPI_KEY=
LITEAPI_ENV=sandbox

# Public env for client-side payment mode toggle (sandbox/live)
NEXT_PUBLIC_LITEAPI_ENV=sandbox

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing secret for checkout booking context cookie
SESSION_SECRET=change-me

# Optional cookie name override
BOOKING_CONTEXT_COOKIE=booking_ctx

# Optional server-side booking session store path (idempotency/session hardening)
BOOKING_SESSION_STORE_PATH=.data/booking-sessions.json
